{
  "info": {
    "name": "Auth GraphQL - Onboarding Flow",
    "_postman_id": "c9c6f3b4-8b2a-4c8c-9a91-1d7c9b123456",
    "description": "Postman collection for onboarding and verify email GraphQL mutations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3009/graphql"
    },
    {
      "key": "mfaToken",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Onboarding (Send OTP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"mutation Onboarding($input: OnboardingInput!) { onboarding(input: $input) { success mfaToken } }\",\n  \"variables\": {\n    \"input\": {\n      \"email\": \"test@example.com\",\n      \"password\": \"StrongPassword123\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      }
    },
    {
      "name": "2. Verify Email (OTP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{mfaToken}}"
          },
          {
            "key": "x-device-token",
            "value": "sample-device-token"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"mutation VerifyEmail($input: VerifyOnboardingInput!) { verifyEmail(input: $input) { success nextStep authToken refreshToken userId xApiKey id } }\",\n  \"variables\": {\n    \"input\": {\n      \"otp\": \"123456\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      }
    }
  ]
}