{
  "info": {
    "name": "Example Target API (Todo App + Utilities)",
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth + Todo flow",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"User 1\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Me (needs token manually)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer REPLACE_ME"
              }
            ],
            "url": {
              "raw": "http://localhost:4000/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "me"
              ]
            }
          }
        },
        {
          "name": "Create Todo (needs token manually)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "authorization",
                "value": "Bearer REPLACE_ME"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy milk\"\n}"
            },
            "url": {
              "raw": "http://localhost:4000/todos",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "todos"
              ]
            }
          }
        },
        {
          "name": "List Todos (needs token manually)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer REPLACE_ME"
              }
            ],
            "url": {
              "raw": "http://localhost:4000/todos",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "todos"
              ]
            }
          }
        }
      ]
    },
