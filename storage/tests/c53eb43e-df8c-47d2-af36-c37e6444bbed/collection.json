{
  "info": {
    "name": "Auth MS - Account + Session Flow",
    "_postman_id": "0f6fb61a-95d2-4db0-9bc7-03d30832e401",
    "description": "Onboarding -> VerifyEmail -> Login -> CurrentSession",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3009/graphql"
    },
    {
      "key": "AUTH_USERNAME",
      "value": "RCC_USR"
    },
    {
      "key": "AUTH_PASSWORD",
      "value": "RCC_PWD"
    },
    {
      "key": "basicAuthToken",
      "value": "UkNDX1VTUjpSQ0NfUFdE"
    },
    {
      "key": "email",
      "value": "user@example.com"
    },
    {
      "key": "password",
      "value": "Password@123"
    },
    {
      "key": "otp",
      "value": "000000"
    },
    {
      "key": "guestId",
      "value": ""
    },
    {
      "key": "mfaToken",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Basic {{basicAuthToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"mutation Login($input: LoginInput!) { login(input: $input) { nextStep id userId email name authToken accessToken refreshToken mfaToken qrUrl platform xApiKey } }\",\n  \"variables\": {\n    \"input\": {\n      \"email\": \"{{email}}\",\n      \"password\": \"{{password}}\",\n      \"userType\": \"User\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      }
    },
    {
      "name": "Current Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query CurrentSession { currentSession { result } }\",\n  \"variables\": {}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      }
    }
  ]
}